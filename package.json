{
  "name": "ibge-mcp-server",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc && tsc-alias",
    "start": "node dist/src/index.js",
    "dev": "tsx src/index.ts",
    "inspect": "npx @modelcontextprotocol/inspector@0.22.0 tsx src/index.ts",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "test": "node --import tsx --test test/**/*.test.ts",
    "test:gemini": "TEST_RUNNER=gemini npm test",
    "test:claude-code": "TEST_RUNNER=claude-code npm test"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.258",
    "@eslint/js": "10.0.1",
    "@types/node": "24.3.1",
    "eslint": "10.1.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.5",
    "prettier": "3.8.1",
    "tsc-alias": "1.9.4",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "typescript-eslint": "8.57.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "axios": "1.11.0",
    "dotenv": "17.3.1",
    "zod": "4.3.6"
  }
}

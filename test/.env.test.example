# Which harness answers the eval prompts: "gemini" or "claude-code".
TEST_RUNNER=gemini

# Required when TEST_RUNNER=gemini
GEMINI_API_KEY=your-gemini-api-key-here

# TEST_RUNNER=claude-code uses your existing `claude` login, or ANTHROPIC_API_KEY.
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Optional overrides
GEMINI_MODEL=gemini-3.1-flash-lite
CLAUDE_CODE_MODEL=claude-opus-5
AGENT_MAX_ITERATIONS=8
